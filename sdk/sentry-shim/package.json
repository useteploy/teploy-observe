{
  "name": "@observe/sentry-shim",
  "version": "0.1.0",
  "description": "Drop-in @sentry/node replacement that ships events to a self-hosted Observe deployment.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test --import tsx tests/*.test.ts",
    "test:integration": "node --test --import tsx tests/integration.test.ts"
  },
  "keywords": [
    "sentry",
    "shim",
    "observability",
    "errors",
    "self-hosted",
    "observe"
  ],
  "author": "Observe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/useteploy/teploy-observe",
    "directory": "sdk/sentry-shim"
  },
  "homepage": "https://github.com/useteploy/teploy-observe",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "sideEffects": false
}
