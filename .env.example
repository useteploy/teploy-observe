# Observe Configuration
# Copy to .env and customize for your deployment.

# Server address
OBSERVE_ADDR=:3000

# Nucleus database connection URL (pgwire-compatible)
OBSERVE_NUCLEUS_URL=postgres://localhost:5432/observe

# Default site ID for single-tenant mode
OBSERVE_SITE_ID=default

# Salt for cookie-free session ID generation.
# IMPORTANT: Change this in production. Same salt = same session IDs across restarts.
OBSERVE_SESSION_SALT=change-me-in-production

# Ingestion buffer settings
OBSERVE_BUFFER_SIZE=100000          # Max events in buffer before backpressure (429)
OBSERVE_FLUSH_INTERVAL_MS=2000      # Flush interval in milliseconds
OBSERVE_FLUSH_SIZE=500              # Flush when this many events are buffered

# Data retention (in days)
OBSERVE_RAW_RETENTION_DAYS=30       # Raw events deleted after this many days
OBSERVE_HOURLY_RETENTION_DAYS=365   # Hourly rollups deleted after this many days
                                     # Daily rollups are kept indefinitely
                                     # Sessions deleted after 90 days (hardcoded)
