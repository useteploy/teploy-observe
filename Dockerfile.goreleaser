# Runtime-only image for goreleaser. goreleaser builds the binary and copies
# it into the build context, so there is no Go toolchain or vendor/ here — that
# sidesteps the vendor-in-build-context problem that deferred Docker in v0.1.0.
# The from-source Dockerfile (used by docker-compose for dev) is kept separately.
FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY teploy-observe /usr/local/bin/teploy-observe

EXPOSE 3000
ENV OBSERVE_ADDR=:3000
ENV OBSERVE_NUCLEUS_URL=postgres://nucleus:5432/observe
ENV OBSERVE_DATA_DIR=/var/lib/observe

VOLUME ["/var/lib/observe"]

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD wget -q --spider http://localhost:3000/healthz || exit 1

ENTRYPOINT ["teploy-observe"]
