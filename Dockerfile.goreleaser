# Runtime-only image for goreleaser. goreleaser builds the binary and copies
# it into the build context, so there is no Go toolchain or vendor/ here — that
# sidesteps the vendor-in-build-context problem that deferred Docker in v0.1.0.
# The from-source Dockerfile (used by docker-compose for dev) is kept separately.
FROM alpine:3.21
# tini is PID 1: it reaps orphaned healthcheck processes (see Dockerfile).
RUN apk add --no-cache ca-certificates tzdata tini
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/observe /usr/local/bin/observe

# Audit F50: dedicated unprivileged runtime identity (same UID/GID as the
# from-source Dockerfile).
RUN addgroup -S -g 10001 observe \
 && adduser -S -D -H -u 10001 -G observe observe \
 && mkdir -p /var/lib/observe \
 && chown observe:observe /var/lib/observe

EXPOSE 3000
ENV OBSERVE_ADDR=:3000
ENV OBSERVE_NUCLEUS_URL=postgres://nucleus:5432/observe
ENV OBSERVE_DATA_DIR=/var/lib/observe

VOLUME ["/var/lib/observe"]

USER 10001:10001

# Same probe as the from-source Dockerfile, whose comment carries the reasons:
# 12s covers a cold Nucleus connect (3s flapped to unhealthy), and wget's own
# -T 10 exits before Docker's timeout so no orphaned wget is left behind.
HEALTHCHECK --interval=15s --timeout=12s --start-period=30s --retries=3 \
    CMD wget -q -T 10 --spider http://localhost:3000/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--", "observe"]
