{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "observe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "siteId": {"type": "string", "minLength": 1},
        "publicUrl": {"type": "string", "pattern": "^(https?://.+)?$"},
        "trustedProxies": {"type": "string"},
        "adminUser": {"type": "string", "minLength": 1},
        "seedDemo": {"type": "boolean"},
        "env": {
          "type": "object",
          "propertyNames": {"pattern": "^OBSERVE_[A-Z0-9_]+$"},
          "additionalProperties": {"type": "string"}
        },
        "extraEnv": {"type": "array"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 30},
        "persistence": {"$ref": "#/definitions/persistence"},
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "nucleus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "externalUrl": {"type": "string", "pattern": "^(postgres(ql)?://.+)?$"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest"]}},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "maxMemoryMB": {"type": "integer", "minimum": 64},
        "persistence": {"$ref": "#/definitions/persistence"},
        "resources": {"type": "object"},
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        },
        "securityContext": {"type": "object"},
        "podSecurityContext": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"},
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jwtSecret": {"type": "string", "minLength": 1},
            "sessionSalt": {"type": "string", "minLength": 1},
            "secretKey": {"type": "string", "minLength": 1},
            "adminPassword": {"type": "string", "minLength": 1}
          }
        },
        "jwtSecret": {"type": "string"},
        "sessionSalt": {"type": "string"},
        "secretKey": {"type": "string"},
        "adminPassword": {"type": "string"},
        "autogenerate": {"type": "boolean"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"}
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535, "not": {"const": 3000}},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "annotations": {"type": "object"}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "host": {"type": "string"},
        "tls": {"$ref": "#/definitions/tls"},
        "ingest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "host": {"type": "string"},
            "annotations": {"type": "object"},
            "tls": {"$ref": "#/definitions/tls"}
          }
        }
      }
    },
    "securityContext": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "tmpSizeLimit": {"type": "string"},
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {"type": "object"},
        "readiness": {"type": "object"},
        "liveness": {"type": "object"}
      }
    }
  },
  "definitions": {
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)$"},
        "storageClassName": {"type": "string"},
        "accessModes": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "secretName": {"type": "string"}
      }
    }
  }
}
