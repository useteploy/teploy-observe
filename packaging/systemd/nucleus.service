[Unit]
Description=Nucleus — Observe's embedded database
Documentation=https://github.com/neutron-build/nucleus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nucleus
Group=nucleus
WorkingDirectory=/var/lib/nucleus

Environment=NUCLEUS_ALLOW_NO_AUTH=1

ExecStart=/usr/local/bin/nucleus start --port 5432 --data /var/lib/nucleus/data --max-memory 512

KillSignal=SIGTERM
TimeoutStopSec=30s
Restart=always
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nucleus
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nucleus

[Install]
WantedBy=multi-user.target
