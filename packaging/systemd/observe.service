[Unit]
Description=Observe - self-hosted observability
Documentation=https://github.com/useteploy/teploy-observe
After=network-online.target nucleus.service
Wants=network-online.target nucleus.service

[Service]
Type=simple
User=observe
Group=observe
WorkingDirectory=/var/lib/observe

# Environment — override any of these via drop-in:
#   systemctl edit observe.service
# and place your secrets in an [Service] section with Environment= lines.
EnvironmentFile=-/etc/observe/observe.env
Environment=OBSERVE_ADDR=:3000
Environment=OBSERVE_NUCLEUS_URL=postgres://localhost:5432/observe
Environment=OBSERVE_SITE_ID=default
Environment=OBSERVE_DATA_DIR=/var/lib/observe

ExecStart=/usr/local/bin/observe

# Graceful shutdown — Observe flushes buffers on SIGTERM.
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=90s
Restart=on-failure
RestartSec=5s

# Hardening — adjust if your setup requires wider access.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/observe
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Resource limits
LimitNOFILE=65536

# Log to journal (view with: journalctl -u observe -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=observe

[Install]
WantedBy=multi-user.target
