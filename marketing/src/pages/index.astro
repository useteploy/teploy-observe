---
import BaseLayout from "../layouts/BaseLayout.astro";

const installCommand = "curl -sL observe.dev/install | sh";

const replaces = [
  {
    name: "PostHog",
    blurb: "Product analytics by ingesting events at the edge and rolling them up nightly.",
    features: [
      "Pageviews, sessions, funnels, retention",
      "Session replays with scrub + speed control",
      "Feature flags with targeting rules",
      "A/B experiments with Bayesian readout",
    ],
  },
  {
    name: "Sentry",
    blurb: "Error tracking via a drop-in Sentry-shim SDK and source-map symbolication.",
    features: [
      "Issue grouping with fingerprints",
      "Stack traces + breadcrumbs + releases",
      "Source-map upload + symbolication",
      "Alert rules with notification routes",
    ],
  },
  {
    name: "SigNoz",
    blurb: "OpenTelemetry traces and structured logs against one Postgres-compatible store.",
    features: [
      "OTLP/HTTP + OTLP/gRPC trace ingest",
      "Waterfall + flame graph views",
      "Service dependency map (RED metrics)",
      "Logs with live tail over SSE",
    ],
  },
  {
    name: "Umami",
    blurb: "Privacy-first web analytics with no cookies and a 2 KB tracker script.",
    features: [
      "Cookieless visitor counting",
      "Country / device / referrer breakdowns",
      "UTM + campaign attribution",
      "Goal + custom-event tracking",
    ],
  },
];

type Mark = "yes" | "no" | "partial";
type CompareCol =
  | "Observe"
  | "PostHog"
  | "Sentry"
  | "SigNoz"
  | "Umami";

const compareColumns: CompareCol[] = [
  "Observe",
  "PostHog",
  "Sentry",
  "SigNoz",
  "Umami",
];

interface Row {
  capability: string;
  values: Record<CompareCol, Mark | string>;
}

const compareRows: Row[] = [
  {
    capability: "Self-host (free)",
    values: { Observe: "yes", PostHog: "yes", Sentry: "yes", SigNoz: "yes", Umami: "yes" },
  },
  {
    capability: "Single binary",
    values: { Observe: "yes", PostHog: "no", Sentry: "no", SigNoz: "no", Umami: "no" },
  },
  {
    capability: "Analytics",
    values: { Observe: "yes", PostHog: "yes", Sentry: "no", SigNoz: "no", Umami: "yes" },
  },
  {
    capability: "Errors",
    values: { Observe: "yes", PostHog: "partial", Sentry: "yes", SigNoz: "no", Umami: "no" },
  },
  {
    capability: "Logs",
    values: { Observe: "yes", PostHog: "no", Sentry: "no", SigNoz: "yes", Umami: "no" },
  },
  {
    capability: "Traces (OTLP)",
    values: { Observe: "yes", PostHog: "no", Sentry: "partial", SigNoz: "yes", Umami: "no" },
  },
  {
    capability: "Session replays",
    values: { Observe: "yes", PostHog: "yes", Sentry: "yes", SigNoz: "no", Umami: "no" },
  },
  {
    capability: "Feature flags",
    values: { Observe: "yes", PostHog: "yes", Sentry: "partial", SigNoz: "no", Umami: "no" },
  },
  {
    capability: "Experiments (A/B)",
    values: { Observe: "yes", PostHog: "yes", Sentry: "no", SigNoz: "no", Umami: "no" },
  },
  {
    capability: "Surveys",
    values: { Observe: "yes", PostHog: "yes", Sentry: "no", SigNoz: "no", Umami: "no" },
  },
  {
    capability: "Dashboards",
    values: { Observe: "yes", PostHog: "yes", Sentry: "yes", SigNoz: "yes", Umami: "partial" },
  },
  {
    capability: "AI query assistant",
    values: { Observe: "yes", PostHog: "yes", Sentry: "no", SigNoz: "no", Umami: "no" },
  },
  {
    capability: "License",
    values: {
      Observe: "AGPLv3",
      PostHog: "MIT + paid",
      Sentry: "FSL",
      SigNoz: "MIT",
      Umami: "MIT",
    },
  },
  {
    capability: "Pricing — 10-person team",
    values: {
      Observe: "$0",
      PostHog: "$0 self-host",
      Sentry: "$0 self-host",
      SigNoz: "$0 self-host",
      Umami: "$0 self-host",
    },
  },
];

function renderMark(v: Mark | string) {
  if (v === "yes") return { html: "&#10003;", className: "mark-yes", label: "yes" };
  if (v === "no") return { html: "&minus;", className: "mark-no", label: "no" };
  if (v === "partial")
    return { html: "partial", className: "mark-partial", label: "partial" };
  return { html: v, className: "mark-text", label: v };
}
---

<BaseLayout
  title="Observe — PostHog + Sentry + SigNoz + Umami in one self-hosted Go binary"
  description="Replace PostHog, Sentry, SigNoz, and Umami with one self-hosted Go binary. Analytics, errors, logs, traces, replays, flags, experiments, and surveys. AGPLv3, runs on a $5 VPS."
>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap">
      <h1 id="hero-h">
        Replace <span class="accent">PostHog + Sentry + SigNoz + Umami</span><br />
        with one self-hosted binary.
      </h1>
      <p class="sub">
        Analytics, errors, logs, traces, session replays, flags, experiments, and surveys
        in a single 26&nbsp;MB Go binary. Free under AGPLv3. Runs on a $5 VPS — no Kafka,
        no ClickHouse, no Kubernetes.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#install">Deploy in 60 seconds</a>
        <a
          class="btn btn-ghost"
          href="https://github.com/useteploy/teploy-observe"
          rel="noopener"
        >
          View on GitHub
        </a>
      </div>
      <p class="hero-meta">
        <span class="dot" aria-hidden="true"></span>
        v0.5 stable &middot; one binary &middot; AGPLv3 server, MIT SDKs
      </p>
    </div>
  </section>

  <!-- ============ WHAT IT REPLACES ============ -->
  <section class="section" id="replaces" aria-labelledby="replaces-h">
    <div class="wrap">
      <h2 id="replaces-h">Four products. One install.</h2>
      <p class="lede">
        Each card is what Observe covers from a competitor — and the four-bullet
        checklist of what's actually shipped today.
      </p>

      <div class="replaces-grid">
        {
          replaces.map((r) => (
            <article class="replace-card" aria-labelledby={`r-${r.name}`}>
              <h3 id={`r-${r.name}`}>{r.name}</h3>
              <p class="what">{r.blurb}</p>
              <ul>
                {r.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ INSTALL ============ -->
  <section class="section section-tight" id="install" aria-labelledby="install-h">
    <div class="wrap">
      <h2 id="install-h">Install in 60 seconds</h2>
      <p class="lede">
        The installer detects your platform, downloads the latest release from GitHub,
        verifies the SHA256, and (optionally) sets up a systemd unit.
      </p>

      <div class="install-block" role="group" aria-label="Install command">
        <code><span class="prompt">$</span>{installCommand}</code>
        <button
          type="button"
          class="copy-btn"
          id="copy-install"
          data-copy={installCommand}
          aria-label="Copy install command to clipboard"
        >
          Copy
        </button>
      </div>

      <div class="install-options">
        <div class="install-option">
          <h4>systemd unit</h4>
          <p>
            Default. The installer drops <code>observe.service</code> into
            <code>/etc/systemd/system</code> and enables it on boot.
          </p>
        </div>
        <div class="install-option">
          <h4>Docker Compose</h4>
          <p>
            <code>docker-compose.yml</code> in the repo wires Observe + Nucleus + Caddy.
            One <code>docker compose up -d</code> away.
          </p>
        </div>
        <div class="install-option">
          <h4>Homebrew / Scoop</h4>
          <p>
            <code>brew install useteploy/teploy-observe/observe</code> on macOS;
            <code>scoop install observe</code> on Windows.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LIVE DEMO ============ -->
  <section class="section section-tight" id="demo" aria-labelledby="demo-h">
    <div class="wrap">
      <h2 id="demo-h">See it before you install</h2>
      <p class="lede">
        Pre-seeded with a week of synthetic traffic, errors, traces, and replays.
        Everything works; nothing writes back.
      </p>

      <a
        class="demo-card"
        href="https://demo.observe.dev"
        rel="noopener"
        aria-labelledby="demo-card-h"
      >
        <div>
          <span class="badge">Read-only</span>
          <h3 id="demo-card-h">demo.observe.dev</h3>
          <p>
            Try every surface — analytics, errors, logs, traces, replays — without
            signing up. The demo is reset hourly.
          </p>
        </div>
        <span class="btn btn-primary" aria-hidden="true">Try without signup &rarr;</span>
      </a>
    </div>
  </section>

  <!-- ============ COMPARISON TABLE ============ -->
  <section class="section" id="compare" aria-labelledby="compare-h">
    <div class="wrap">
      <h2 id="compare-h">How it compares</h2>
      <p class="lede">
        Honest comparison. Where Observe loses, the row says so. Self-host columns
        assume you run the open-source distribution, not the SaaS.
      </p>

      <div class="compare-wrap" role="region" aria-label="Feature comparison" tabindex="0">
        <table class="compare-table">
          <caption class="visually-hidden">
            Feature-by-feature comparison of Observe with PostHog, Sentry, SigNoz, and
            Umami.
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              {
                compareColumns.map((c) => (
                  <th scope="col" class={c === "Observe" ? "us" : ""}>
                    {c}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              compareRows.map((row) => (
                <tr>
                  <th scope="row">{row.capability}</th>
                  {compareColumns.map((c) => {
                    const m = renderMark(row.values[c]);
                    return (
                      <td>
                        <span
                          class={m.className}
                          aria-label={m.label}
                          set:html={m.html}
                        />
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="compare-note">
        Notes: PostHog ships error-tracking as a beta module (marked partial). Sentry
        Tracing covers OTLP for clients, not full backend distributed tracing
        (partial). SigNoz feature-flag rules are external (Unleash integration,
        partial). Umami's "dashboards" are limited to the built-in analytics overview
        (partial). Pricing rows show cost when self-hosting; SaaS plans differ.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Inline-cheap clipboard handler. ~250 bytes after minification.
  const btn = document.getElementById("copy-install") as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = "Copied";
        btn.setAttribute("aria-live", "polite");
        setTimeout(() => {
          btn.textContent = prev;
        }, 1400);
      } catch {
        btn.textContent = "Copy failed";
      }
    });
  }
</script>
