---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const {
  title,
  description,
  canonical = Astro.site?.toString() ?? "https://observe.dev/",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6366f1" />
    <meta name="color-scheme" content="light dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Observe" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon: inline SVG, no extra request -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%236366f1'/%3E%3Ctext x='16' y='22' font-family='-apple-system,system-ui,sans-serif' font-size='18' font-weight='700' fill='white' text-anchor='middle'%3EO%3C/text%3E%3C/svg%3E"
    />

    <!-- Preconnect to GitHub for the secondary CTA -->
    <link rel="preconnect" href="https://github.com" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="Observe — home">
          <span class="mark" aria-hidden="true">O</span>
          <span>Observe</span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          <a href="#replaces">What it replaces</a>
          <a href="#install">Install</a>
          <a href="#compare">Compare</a>
          <a href="https://github.com/useteploy/teploy-observe" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href="/" class="brand" aria-label="Observe — home">
              <span class="mark" aria-hidden="true">O</span>
              <span>Observe</span>
            </a>
            <p>
              Self-hosted analytics, errors, logs, traces, replays, flags, experiments,
              and surveys. One Go binary. AGPLv3.
            </p>
          </div>

          <div>
            <h4>Product</h4>
            <ul>
              <li><a href="#replaces">What it replaces</a></li>
              <li><a href="#install">Install</a></li>
              <li><a href="#demo">Live demo</a></li>
              <li><a href="#compare">Comparison</a></li>
            </ul>
          </div>

          <div>
            <h4>Project</h4>
            <ul>
              <li>
                <a href="https://github.com/useteploy/teploy-observe" rel="noopener"
                  >GitHub repo</a
                >
              </li>
              <li>
                <a
                  href="https://github.com/useteploy/teploy-observe/blob/main/docs"
                  rel="noopener">Docs</a
                >
              </li>
              <li>
                <a
                  href="https://github.com/useteploy/teploy-observe/releases"
                  rel="noopener">Releases</a
                >
              </li>
              <li>
                <a
                  href="https://github.com/useteploy/teploy-observe/blob/main/LICENSE"
                  rel="noopener">License (AGPLv3)</a
                >
              </li>
            </ul>
          </div>

          <div>
            <h4>Community</h4>
            <ul>
              <li>
                <a
                  href="https://github.com/useteploy/teploy-observe/issues"
                  rel="noopener">Issues</a
                >
              </li>
              <li>
                <a
                  href="https://github.com/useteploy/teploy-observe/discussions"
                  rel="noopener">Discussions</a
                >
              </li>
              <!-- Social links: room reserved, none yet. -->
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} Observe. AGPLv3 licensed.</span>
          <span>SDKs (browser, sentry-shim, python, go) MIT-licensed.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
